# -----------------------------------------------------------------------
# Public (safe to expose to the browser) — used by the student experience
# and by the teacher dashboard's Supabase Auth login.
# -----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------
# SECRET — server-side only. Never import this in a "use client" file or
# expose it in any API response. It is used only inside src/app/api/*
# route handlers (which run on the server) to read/write investigation
# rows on behalf of anonymous students, since students have no login.
# -----------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
